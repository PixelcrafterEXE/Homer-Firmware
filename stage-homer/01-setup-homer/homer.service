[Unit]
Description=HomerPi Application
After=multi-user.target

[Service]
Type=simple
User=${FIRST_USER_NAME}
WorkingDirectory=/home/${FIRST_USER_NAME}/Software
ExecStart=/usr/bin/xinit /bin/sh -c "matchbox-window-manager -use_cursor no -use_titlebar no & sleep 2 && dbus-run-session sh -c 'onboard & exec python3 main.py'" -- :0 vt7 -s 0 -dpms
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target