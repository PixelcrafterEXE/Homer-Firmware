[Unit]
Description=HomerPi Application
After=network.target

[Service]
Type=simple
User=${FIRST_USER_NAME}
WorkingDirectory=/home/${FIRST_USER_NAME}/Software
ExecStart=/usr/bin/python3 /home/${FIRST_USER_NAME}/Software/main.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
